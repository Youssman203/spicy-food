# Domaine public uniquement : sans https://, chemin, port ni slash final.
# Remplacer cet exemple avant de lancer le service.
SPICY_DOMAIN=spicy.example.com

# Utiliser un nouveau tag a chaque livraison et conserver l'image precedente.
SPICY_IMAGE_TAG=v1.0.0

# Nom stable de cette installation (reseau Docker et labels Traefik).
COMPOSE_PROJECT_NAME=spicy-v1
